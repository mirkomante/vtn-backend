# ===========================================
# CONFIGURAZIONE AMBIENTE - VIETNAMONAMOUR
# ===========================================
# Copia questo file come .env e configura i valori

# ===========================================
# DATABASE
# ===========================================
# URL di connessione PostgreSQL (OBBLIGATORIO)
DATABASE_URL="postgresql://username:password@localhost:5432/vietnamonamour"

# ===========================================
# SESSIONI
# ===========================================
# Chiave segreta per le sessioni (OBBLIGATORIO)
# Deve essere almeno 32 caratteri per sicurezza
SESSION_SECRET="your-super-secret-session-key-at-least-32-characters-long"

# ===========================================
# AUTENTICAZIONE
# ===========================================
# Abilita/disabilita strategie di autenticazione
AUTH_LOCAL_ENABLED=true
AUTH_GOOGLE_ENABLED=true

# Google OAuth (richiesto se AUTH_GOOGLE_ENABLED=true)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ===========================================
# MENU E INTERFACCIA
# ===========================================
# Menu Ristorante
MENU_RISTORANTE=true

# Menu Admin
MENU_ADMIN=true


# ===========================================
# SERVER
# ===========================================
# Porta del server (default: 8080)
PORT=8080

# Ambiente di esecuzione
NODE_ENV=development

# ===========================================
# PRISMA
# ===========================================
# URL del database per Prisma (di solito uguale a DATABASE_URL)
# Prisma può usare DATABASE_URL direttamente, ma puoi specificare un URL diverso se necessario
# PRISMA_DATABASE_URL="postgresql://username:password@localhost:5432/vietnamonamour"

# ===========================================
# LOGGING
# ===========================================
# Livello di logging (opzionale)
# LOG_LEVEL=info

# ===========================================
# SICUREZZA
# ===========================================
# Chiave per crittografia (opzionale, per funzionalità future)
# ENCRYPTION_KEY="your-encryption-key"

# ===========================================
# MONITORAGGIO
# ===========================================
# Abilita endpoint di monitoraggio (opzionale)
# HEALTH_CHECK_ENABLED=true

# ===========================================
# SVILUPPO
# ===========================================
# Abilita debug mode (solo per sviluppo)
# DEBUG=true

# Abilita logging dettagliato (solo per sviluppo)
# VERBOSE_LOGGING=true

# ===========================================
# PRODUZIONE
# ===========================================
# Per ambiente di produzione, assicurati di:
# 1. Usare password complesse e uniche
# 2. Impostare NODE_ENV=production
# 3. Usare HTTPS per SESSION_SECRET
# 4. Configurare firewall e accessi database
# 5. Abilitare solo i menu necessari
# 6. Configurare backup automatici
# 7. Impostare monitoraggio e alerting

# ===========================================
# ESEMPI DI CONFIGURAZIONE
# ===========================================

# SVILUPPO LOCALE
# DATABASE_URL="postgresql://postgres:password@localhost:5432/vietnamonamour_dev"
# SESSION_SECRET="dev-session-secret-key-32-chars-minimum"
# AUTH_LOCAL_ENABLED=true
# AUTH_GOOGLE_ENABLED=false
# MENU_RISTORANTE=true
# MENU_ADMIN=true
# NODE_ENV=development

# STAGING
# DATABASE_URL="postgresql://user:pass@staging-db:5432/vietnamonamour_staging"
# SESSION_SECRET="staging-session-secret-key-32-chars-minimum"
# AUTH_LOCAL_ENABLED=true
# AUTH_GOOGLE_ENABLED=true
# MENU_RISTORANTE=true
# MENU_ADMIN=true
# MENU_ANALYTICS_ENABLED=true
# NODE_ENV=staging

# ===========================================
# CONFIGURAZIONE PRODUZIONE - VIETNAMONAMOUR
# ===========================================

# DATABASE
DATABASE_URL="postgresql://prod_user:secure_password@prod-db:5432/vietnamonamour"

# SESSIONI
SESSION_SECRET="production-session-secret-key-32-chars-minimum"

# AUTENTICAZIONE
AUTH_LOCAL_ENABLED=true
AUTH_GOOGLE_ENABLED=true
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# MENU
MENU_RISTORANTE=true
MENU_ADMIN=true

# SERVER
PORT=8080
NODE_ENV=production
