# ===========================================
# CONFIGURAZIONE PRODUZIONE - VIETNAMONAMOUR
# ===========================================
# Questo file contiene le variabili d'ambiente per la produzione
# Le variabili sensibili sono gestite tramite Secret Manager

# ===========================================
# SERVER
# ===========================================
NODE_ENV=production
PORT=8080

# ===========================================
# AUTENTICAZIONE
# ===========================================
AUTH_LOCAL_ENABLED=true
AUTH_GOOGLE_ENABLED=true

# ===========================================
# MENU
# ===========================================
MENU_RISTORANTE=true
MENU_ADMIN=true

# ===========================================
# SICUREZZA
# ===========================================
# Le variabili sensibili sono gestite tramite Secret Manager:
# - DATABASE_URL
# - SESSION_SECRET
# - GOOGLE_CLIENT_ID
# - GOOGLE_CLIENT_SECRET

# ===========================================
# CLOUD RUN
# ===========================================
# Cloud Run imposta automaticamente:
# - PORT (da variabile d'ambiente PORT)
# - NODE_ENV (da variabile d'ambiente NODE_ENV)

# ===========================================
# MONITORAGGIO
# ===========================================
# Cloud Run fornisce automaticamente:
# - Logging (Cloud Logging)
# - Monitoring (Cloud Monitoring)
# - Tracing (Cloud Trace)
