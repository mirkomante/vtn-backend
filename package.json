{
  "name": "vtn-backen",
  "version": "1.0.0",
  "description": "Backend per Vietnamonamour",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "concurrently \"ts-node-dev --respawn --transpile-only src/server.ts\" \"npm run watch:css\"",
    "dev:quiet": "concurrently \"ts-node-dev --respawn --transpile-only --no-deprecation src/server.ts\" \"npm run watch:css\"",
    "dev:no-warnings": "NODE_NO_WARNINGS=1 concurrently \"ts-node-dev --respawn --transpile-only src/server.ts\" \"npm run watch:css\"",
    "build": "tsc && npm run build:css",
    "build:css": "postcss src/public/css/tailwind.css -o src/public/css/styles.css",
    "watch:css": "postcss src/public/css/tailwind.css -o src/public/css/styles.css --watch",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^6.8.2",
    "@types/connect-pg-simple": "^7.0.3",
    "@types/pg": "^8.15.2",
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^10.0.0",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.9",
    "express": "^4.18.2",
    "express-ejs-layouts": "^2.5.1",
    "express-session": "^1.18.0",
    "express-validator": "^7.2.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-local": "^1.0.0",
    "pg": "^8.16.0",
    "prisma": "^6.8.2",
    "rate-limiter-flexible": "^8.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.21",
    "@types/express-ejs-layouts": "^2.5.4",
    "@types/express-session": "^1.17.10",
    "@types/express-validator": "^2.20.33",
    "@types/node": "^20.11.20",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-local": "^1.0.38",
    "@types/winston": "^2.4.4",
    "autoprefixer": "^10.4.17",
    "concurrently": "^8.2.2",
    "postcss": "^8.4.35",
    "postcss-cli": "^11.0.0",
    "tailwindcss": "^4.1.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
