generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(uuid())
  email          String    @unique
  password       String?
  role           String    @default("user")
  googleId       String?   @unique
  authProvider   String    @default("local")
  auth           String    @default("user")
  profilePicture String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  familyName     String?
  givenName      String?
  deletedAt      DateTime?
}

model Session {
  sid    String   @id
  sess   Json
  expire DateTime

  @@map("session")
}

model CategoriaPiatti {
  id          String    @id @default(uuid())
  nome        String    @unique
  descrizione String?
  inLista     Boolean   @default(true)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  piatti      Piatto[]

  @@map("categoria_piatti")
}

model CategoriaMenuFisso {
  id          String      @id @default(uuid())
  nome        String      @unique
  descrizione String?
  inLista     Boolean     @default(true)
  deletedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  menuFissi   MenuFisso[]

  @@map("categoria_menu_fisso")
}

model Allergene {
  id          String            @id @default(uuid())
  nome        String            @unique
  descrizione String?
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  piatti      PiattoAllergene[]

  @@map("allergeni")
}

model Piatto {
  id            String   @id @default(uuid())
  nome          String
  descrizione   String?
  prezzo        Decimal  @db.Decimal(10, 2)
  inLista       Boolean  @default(true)
  glutenFree    Boolean  @default(false)
  noLatticini   Boolean  @default(false)
  vegan         Boolean  @default(false)
  noUovo        Boolean  @default(false)
  soloMenuFissi Boolean  @default(false)
  deletedAt     DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relazioni
  categoriaId String
  categoria   CategoriaPiatti @relation(fields: [categoriaId], references: [id])
  
  allergeni   PiattoAllergene[]
  menuFissi   MenuFissoPiatto[]

  @@map("piatti")
}

model PiattoAllergene {
  id          String    @id @default(uuid())
  piattoId    String
  allergeneId String
  createdAt   DateTime  @default(now())
  allergene   Allergene @relation(fields: [allergeneId], references: [id], onDelete: Cascade)
  piatto      Piatto    @relation(fields: [piattoId], references: [id], onDelete: Cascade)

  @@unique([piattoId, allergeneId])
  @@map("piatto_allergene")
}

model ServizioAccessorio {
  id          String                        @id @default(uuid())
  nome        String
  descrizione String?
  prezzo      Decimal                       @db.Decimal(10, 2)
  inLista     Boolean                       @default(true)
  deletedAt   DateTime?
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt
  menuFissi   MenuFissoServizioAccessorio[]

  @@map("servizi_accessori")
}

model MenuFisso {
  id          String                        @id @default(uuid())
  nome        String
  descrizione String?
  prezzo      Decimal                       @db.Decimal(10, 2)
  inLista     Boolean                       @default(true)
  deletedAt   DateTime?
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt
  categoriaId String
  categoria   CategoriaMenuFisso            @relation(fields: [categoriaId], references: [id])
  piatti      MenuFissoPiatto[]
  servizi     MenuFissoServizioAccessorio[]

  @@map("menu_fisso")
}

model MenuFissoPiatto {
  id          String    @id @default(uuid())
  menuFissoId String
  piattoId    String
  createdAt   DateTime  @default(now())
  menuFisso   MenuFisso @relation(fields: [menuFissoId], references: [id], onDelete: Cascade)
  piatto      Piatto    @relation(fields: [piattoId], references: [id], onDelete: Cascade)

  @@unique([menuFissoId, piattoId])
  @@map("menu_fisso_piatto")
}

model MenuFissoServizioAccessorio {
  id                   String             @id @default(uuid())
  menuFissoId          String
  servizioAccessorioId String
  createdAt            DateTime           @default(now())
  menuFisso            MenuFisso          @relation(fields: [menuFissoId], references: [id], onDelete: Cascade)
  servizioAccessorio   ServizioAccessorio @relation(fields: [servizioAccessorioId], references: [id], onDelete: Cascade)

  @@unique([menuFissoId, servizioAccessorioId])
  @@map("menu_fisso_servizio_accessorio")
}

model Nazione {
  id        String     @id @default(uuid())
  nome      String     @unique
  sigla     String     @unique
  deletedAt DateTime?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  bevande   Bevanda[]
  birre     Birra[]
  cocktail  Cocktail[]
  liquori   Liquore[]
  regioni   Regione[]
  vini      Vino[]
  zone      Zona[]

  @@map("nazioni")
}

model Regione {
  id        String    @id @default(uuid())
  nome      String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  nazioneId String
  nazione   Nazione   @relation(fields: [nazioneId], references: [id])
  vini      Vino[]
  zone      Zona[]

  @@unique([nome, nazioneId])
  @@map("regioni")
}

model Zona {
  id        String    @id @default(uuid())
  nome      String
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  regioneId String
  nazioneId String
  vini      Vino[]
  nazione   Nazione   @relation(fields: [nazioneId], references: [id])
  regione   Regione   @relation(fields: [regioneId], references: [id])

  @@unique([nome, regioneId])
  @@map("zone")
}

model TipologiaVino {
  id          String    @id @default(uuid())
  nome        String    @unique
  descrizione String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  vini        Vino[]

  @@map("tipologie_vino")
}

model TipologiaBirra {
  id          String    @id @default(uuid())
  nome        String    @unique
  descrizione String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  birre       Birra[]

  @@map("tipologie_birra")
}

model TipologiaLiquore {
  id          String    @id @default(uuid())
  nome        String    @unique
  descrizione String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  liquori     Liquore[]

  @@map("tipologie_liquore")
}

model TipologiaCocktail {
  id          String     @id @default(uuid())
  nome        String     @unique
  descrizione String?
  deletedAt   DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  cocktail    Cocktail[]

  @@map("tipologie_cocktail")
}

model TipologiaBevanda {
  id          String    @id @default(uuid())
  nome        String    @unique
  descrizione String?
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  bevande     Bevanda[]

  @@map("tipologie_bevanda")
}

model Vino {
  id             String        @id @default(uuid())
  nome           String
  descrizione    String?
  cantina        String?
  certificazione String?
  capacita       String?
  prezzoCalice   Decimal?      @db.Decimal(10, 2)
  prezzo         Decimal       @db.Decimal(10, 2)
  inLista        Boolean       @default(true)
  deletedAt      DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  zonaId         String?
  regioneId      String?
  nazioneId      String
  tipologiaId    String
  grado          String?
  anno           String?
  nazione        Nazione       @relation(fields: [nazioneId], references: [id])
  regione        Regione?      @relation(fields: [regioneId], references: [id])
  tipologia      TipologiaVino @relation(fields: [tipologiaId], references: [id])
  zona           Zona?         @relation(fields: [zonaId], references: [id])

  @@map("vini")
}

model Birra {
  id          String         @id @default(uuid())
  nome        String
  descrizione String?
  grado       String?
  capacita    String?
  prezzo      Decimal        @db.Decimal(10, 2)
  inLista     Boolean        @default(true)
  deletedAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  nazioneId   String
  tipologiaId String
  nazione     Nazione        @relation(fields: [nazioneId], references: [id])
  tipologia   TipologiaBirra @relation(fields: [tipologiaId], references: [id])

  @@map("birre")
}

model Liquore {
  id             String           @id @default(uuid())
  nome           String
  descrizione    String?
  grado          String?
  invecchiamento String?
  capacita       String?
  prezzo         Decimal          @db.Decimal(10, 2)
  inLista        Boolean          @default(true)
  deletedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  nazioneId      String
  tipologiaId    String
  nazione        Nazione          @relation(fields: [nazioneId], references: [id])
  tipologia      TipologiaLiquore @relation(fields: [tipologiaId], references: [id])

  @@map("liquori")
}

model Cocktail {
  id          String            @id @default(uuid())
  nome        String
  descrizione String?
  prezzo      Decimal           @db.Decimal(10, 2)
  inLista     Boolean           @default(true)
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  nazioneId   String?
  tipologiaId String
  nazione     Nazione?          @relation(fields: [nazioneId], references: [id])
  tipologia   TipologiaCocktail @relation(fields: [tipologiaId], references: [id])

  @@map("cocktail")
}

model Bevanda {
  id          String           @id @default(uuid())
  nome        String
  descrizione String?
  prezzo      Decimal          @db.Decimal(10, 2)
  inLista     Boolean          @default(true)
  deletedAt   DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  nazioneId   String?
  tipologiaId String
  nazione     Nazione?         @relation(fields: [nazioneId], references: [id])
  tipologia   TipologiaBevanda @relation(fields: [tipologiaId], references: [id])

  @@map("bevande")
}

model Logs {
  id          BigInt   @id @default(autoincrement())
  level       String   @db.VarChar(10)
  message     String
  timestamp   DateTime @default(now())
  category    String   @db.VarChar(20)
  request_id  String?  @db.VarChar(100)
  user_id     String?  @db.VarChar(100)
  ip_address  String?  @db.Inet
  user_agent  String?
  method      String?  @db.VarChar(10)
  url         String?
  status_code Int?
  duration    Int?
  metadata    Json?
  created_at  DateTime @default(now())

  @@map("logs")
}
