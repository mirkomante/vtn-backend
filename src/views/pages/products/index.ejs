<div class="pt-5">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto">
      <h1 class="text-base font-semibold text-gray-900"><%= title || 'Elementi' %></h1>
      <p class="mt-2 text-sm text-gray-700"><%= description || 'Lista degli elementi.' %></p>
    </div>
    <div class="mt-4 sm:mt-0 sm:ml-16 sm:flex-none">
      <% if (actionButton) { %>
        <a href="<%= actionButton.href %>" 
           class="block rounded-md bg-indigo-600 px-3 py-2 text-center text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
          <%= actionButton.text %>
        </a>
      <% } %>
    </div>
  </div>
  <div class="mt-8 flow-root">
    <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
      <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
        <div class="group/table relative">
          <div class="absolute top-0 left-14 hidden h-12 items-center space-x-3 bg-white group-has-checked/table:flex sm:left-12">
            <button type="button" class="inline-flex items-center rounded-sm bg-white px-2 py-1 text-sm font-semibold text-gray-900 shadow-xs ring-1 ring-gray-300 ring-inset hover:bg-gray-50 disabled:cursor-not-allowed disabled:opacity-30 disabled:hover:bg-white">Modifica multipla</button>
            <button type="button" id="actionSelectedBtn" class="inline-flex items-center rounded-sm bg-red-600 px-2 py-1 text-sm font-semibold text-white shadow-xs ring-1 ring-red-600 ring-inset hover:bg-red-700 disabled:cursor-not-allowed disabled:opacity-30 disabled:hover:bg-red-600"><%= tableConfig.actionButtonText || 'Elimina selezionati' %></button>
          </div>

          <table id="<%= tableId %>" class="min-w-full table-fixed divide-y divide-gray-300">
            <thead>
              <tr>
                <th scope="col" class="relative px-7 sm:w-12 sm:px-6">
                  <div class="group absolute top-1/2 left-4 -mt-2 grid size-4 grid-cols-1">
                    <input type="checkbox" class="col-start-1 row-start-1 appearance-none rounded-sm border border-gray-300 bg-white checked:border-indigo-600 checked:bg-indigo-600 indeterminate:border-indigo-600 indeterminate:bg-indigo-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 disabled:border-gray-300 disabled:bg-gray-100 disabled:checked:bg-gray-100 forced-colors:appearance-auto" />
                    <svg viewBox="0 0 14 14" fill="none" class="pointer-events-none col-start-1 row-start-1 size-3.5 self-center justify-self-center stroke-white group-has-disabled:stroke-gray-950/25">
                      <path d="M3 8L6 11L11 3.5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-0 group-has-checked:opacity-100" />
                      <path d="M3 7H11" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-0 group-has-indeterminate:opacity-100" />
                    </svg>
                  </div>
                </th>
                <% tableData.tableHeads.forEach(head => { %>
                  <th scope="col" class="<%= head.mobile ? '' : 'hidden sm:table-cell' %> px-3 py-3.5 text-left text-sm font-semibold text-gray-900">
                    <%= head.label %>
                  </th>
                <% }); %>
                <th scope="col" class="relative py-3.5 pr-4 pl-3 sm:pr-3">
                  <span class="sr-only">Azioni</span>
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200 bg-white">
              <% items.forEach(item => { %>
                <tr class="group has-checked:bg-gray-50" data-item-id="<%= item[tableConfig.idField] %>">
                  <td class="relative px-7 sm:w-12 sm:px-6">
                    <div class="absolute inset-y-0 left-0 hidden w-0.5 bg-indigo-600 group-has-checked:block"></div>

                    <div class="group absolute top-1/2 left-4 -mt-2 grid size-4 grid-cols-1">
                      <input type="checkbox" class="col-start-1 row-start-1 appearance-none rounded-sm border border-gray-300 bg-white checked:border-indigo-600 checked:bg-indigo-600 indeterminate:border-indigo-600 indeterminate:bg-indigo-600 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 disabled:border-gray-300 disabled:bg-gray-100 disabled:checked:bg-gray-100 forced-colors:appearance-auto" />
                      <svg viewBox="0 0 14 14" fill="none" class="pointer-events-none col-start-1 row-start-1 size-3.5 self-center justify-self-center stroke-white group-has-disabled:stroke-gray-950/25">
                        <path d="M3 8L6 11L11 3.5" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-0 group-has-checked:opacity-100" />
                        <path d="M3 7H11" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="opacity-0 group-has-indeterminate:opacity-100" />
                      </svg>
                    </div>
                  </td>
                  <% tableData.fields.forEach((field, index) => { %>
                    <td class="<%= !tableData.tableHeads[index].mobile ? 'hidden sm:table-cell' : '' %> px-3 py-4 text-sm whitespace-nowrap text-gray-500 <%= field.name === tableConfig.labelField ? 'font-medium text-gray-900 group-has-checked:text-indigo-600' : '' %>">
                      <% if (field.name === tableConfig.labelField) { %>
                        <a href="<%= tableConfig.detailUrl.replace(':id', item[tableConfig.idField]) %>" class="text-indigo-600 hover:text-indigo-900">
                          <%= tableConfig.getDisplayValue ? tableConfig.getDisplayValue(item) : item[field.name] %>
                        </a>
                      <% } else { %>
                        <%= item[field.name] %>
                      <% } %>
                    </td>
                  <% }); %>
                  <td class="py-4 pr-4 pl-3 text-right text-sm font-medium whitespace-nowrap sm:pr-3">
                    <div class="flex justify-end space-x-2">
                      <a href="<%= tableConfig.editUrl.replace(':id', item[tableConfig.idField]) %>" class="text-indigo-600 hover:text-indigo-900">Modifica</a>
                    </div>
                  </td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
```

<script>
  window['products-tableConfig'] = <%- JSON.stringify({
    idField: 'id',
    labelField: 'title',
    detailUrl: '/admin/prodotti/dettagli/:id',
    editUrl: '/admin/prodotti/modifica/:id',
    actionButtonText: 'Elimina selezionati',
    endpoint: '/admin/prodotti',
    method: 'DELETE',
    confirmMessage: 'Sei sicuro di voler eliminare questo prodotto?',
    confirmMessageMultiple: 'Sei sicuro di voler eliminare {count} prodotti?',
    successMessage: 'Eliminati {count} prodotto/i con successo',
    errorMessage: 'Errore durante l\'eliminazione',
    getDisplayValue: (product) => product.title
  }) %>
</script>