<!-- Messaggio di successo se presente -->
<% if (typeof success !== 'undefined' && success && success.length > 0) { %>
  <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-md">
    <div class="flex items-center">
      <svg class="w-5 h-5 text-green-400 mr-2" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
      </svg>
      <span class="text-green-800"><%= success[0] %></span>
    </div>
  </div>
<% } %>

<!-- Messaggio di errore se presente -->
<% if (typeof error !== 'undefined' && error && error.length > 0) { %>
  <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-md">
    <div class="flex items-center">
      <svg class="w-5 h-5 text-red-400 mr-2" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
      </svg>
      <span class="text-red-800"><%= error[0] %></span>
    </div>
  </div>
<% } %>

<!-- Istruzioni -->
<div class="mb-6">
  <div class="bg-blue-50 border border-blue-200 rounded-md p-4">
    <div class="flex">
      <div class="flex-shrink-0">
        <svg class="h-5 w-5 text-blue-400" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
        </svg>
      </div>
      <div class="ml-3">
        <h3 class="text-sm font-medium text-blue-800">
          Istruzioni per la modifica massiva
        </h3>
        <div class="mt-2 text-sm text-blue-700">
          <ul class="list-disc list-inside space-y-1">
            <li>Seleziona i cocktails che vuoi modificare dalla lista</li>
            <li>Compila solo i campi che vuoi aggiornare</li>
            <li>I campi lasciati vuoti non verranno modificati</li>
            <li>Per i campi di tipo toggle, seleziona "Mantieni stato attuale" per non modificare il valore</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Form -->
<%- include('../../../ui/forms/simpleGenericForm', {
  formConfig: formData.formConfig,
  fields: formData.fields,
  buttons: formData.buttons,
  itemType: 'Cocktail',
  selectedItems: selectedItems,
  selectedItemsData: selectedItems,
  isEdit: false,
  isBulkEdit: true
}) %>
