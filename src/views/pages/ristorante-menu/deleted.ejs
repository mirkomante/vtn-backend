<% if (isSectionEmpty) { %>
  <%- include('../../ui/emptyStates/simple', emptyState) %>
<% } else { %>
  <!-- Tabella con filtri integrati -->
  <%- include('../../ui/tables/selectableTable', {
    actionButton: null,
    tableId: 'deleted-items-table',
    tableData: tableData,
    items: deletedItems,
    showFilters: true,
    filters: [
      {
        id: 'type',
        name: 'type',
        label: 'Tipo',
        type: 'select',
        placeholder: 'Tutti i tipi',
        options: [
          { value: '', label: 'Tutti i tipi' },
          { value: 'allergene', label: 'Allergene', selected: currentTypeFilter === 'allergene' },
          { value: 'categoria-menu-fisso', label: 'Categoria Menu Fisso', selected: currentTypeFilter === 'categoria-menu-fisso' },
          { value: 'categoria-piatti', label: 'Categoria Piatti', selected: currentTypeFilter === 'categoria-piatti' },
          { value: 'menu-fisso', label: 'Menu Fisso', selected: currentTypeFilter === 'menu-fisso' },
          { value: 'nazione', label: 'Nazione', selected: currentTypeFilter === 'nazione' },
          { value: 'piatto', label: 'Piatto', selected: currentTypeFilter === 'piatto' },
          { value: 'regione', label: 'Regione', selected: currentTypeFilter === 'regione' },
          { value: 'servizio-accessorio', label: 'Servizio Accessorio', selected: currentTypeFilter === 'servizio-accessorio' },
          { value: 'tipologia-bevanda', label: 'Tipologia Bevanda', selected: currentTypeFilter === 'tipologia-bevanda' },
          { value: 'tipologia-birra', label: 'Tipologia Birra', selected: currentTypeFilter === 'tipologia-birra' },
          { value: 'tipologia-cocktail', label: 'Tipologia Cocktail', selected: currentTypeFilter === 'tipologia-cocktail' },
          { value: 'tipologia-liquore', label: 'Tipologia Liquore', selected: currentTypeFilter === 'tipologia-liquore' },
          { value: 'tipologia-vino', label: 'Tipologia Vino', selected: currentTypeFilter === 'tipologia-vino' },
          { value: 'zona', label: 'Zona', selected: currentTypeFilter === 'zona' }
        ]
      }
    ],
    hasActiveFilters: !!currentTypeFilter,
    clearFiltersUrl: '/ristorante-menu/cancellati',
    showEmptyMessage: isFilteredEmpty,
    emptyMessage: {
      title: 'Nessun elemento trovato',
      description: 'Non ci sono elementi che corrispondono ai filtri applicati.',
      icon: `<svg class="h-12 w-12 text-gray-400" fill="none" viewBox="${uiIcons['ricerca'].viewBox}" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="${uiIcons['ricerca'].path}" />
      </svg>`
    },
    tableConfig: {
      idField: 'id',
      labelField: 'nome',
      editMultipleButton: null,
      bulkEditUrl: null,
      editUrl: null,
      actionButtons: [
        {
          text: 'Ripristina',
          classes: 'bg-green-600 text-white ring-green-600 hover:bg-green-700 disabled:hover:bg-green-600',
          endpoint: '/ristorante-menu/restore',
          method: 'POST',
          confirmMessage: 'Sei sicuro di voler ripristinare questo elemento?',
          confirmMessageMultiple: 'Sei sicuro di voler ripristinare {count} elementi?',
          successMessage: 'Ripristinati {count} elemento/i con successo',
          errorMessage: 'Errore durante il ripristino'
        },
        {
          text: 'Elimina definitivamente',
          classes: 'bg-red-600 text-white ring-red-600 hover:bg-red-700 disabled:hover:bg-red-600',
          endpoint: '/ristorante-menu/permanent-delete',
          method: 'DELETE',
          confirmMessage: 'ATTENZIONE: Questa azione è irreversibile! Sei sicuro di voler eliminare definitivamente questo elemento?',
          confirmMessageMultiple: 'ATTENZIONE: Questa azione è irreversibile! Sei sicuro di voler eliminare definitivamente {count} elementi?',
          successMessage: 'Eliminati definitivamente {count} elemento/i',
          errorMessage: 'Errore durante l\'eliminazione definitiva'
        }
      ],
      disableClickableNames: true
    },
    pagination: typeof pagination !== 'undefined' ? pagination : undefined
  }) %>
<% } %>

<!-- Configurazione JavaScript per la tabella -->
<script>
  window['deleted-items-table-config'] = {
    tableId: 'deleted-items-table',
    idField: 'id',
    labelField: 'nome',
    editMultipleButton: null,
    bulkEditUrl: null,
    editUrl: null,
    actionButtons: [
      {
        text: 'Ripristina',
        classes: 'bg-green-600 text-white ring-green-600 hover:bg-green-700 disabled:hover:bg-red-600',
        endpoint: '/ristorante-menu/restore',
        method: 'POST',
        confirmMessage: 'Sei sicuro di voler ripristinare questo elemento?',
        confirmMessageMultiple: 'Sei sicuro di voler ripristinare {count} elementi?',
        successMessage: 'Ripristinati {count} elemento/i con successo',
        errorMessage: 'Errore durante il ripristino'
      },
      {
        text: 'Elimina definitivamente',
        classes: 'bg-red-600 text-white ring-red-600 hover:bg-red-700 disabled:hover:bg-red-600',
        endpoint: '/ristorante-menu/permanent-delete',
        method: 'DELETE',
        confirmMessage: 'ATTENZIONE: Questa azione è irreversibile! Sei sicuro di voler eliminare definitivamente questo elemento?',
        confirmMessageMultiple: 'ATTENZIONE: Questa azione è irreversibile! Sei sicuro di voler eliminare definitivamente {count} elementi?',
        successMessage: 'Eliminati definitivamente {count} elemento/i',
        errorMessage: 'Errore durante l\'eliminazione definitiva'
      }
    ],
    disableClickableNames: true
  };
</script>