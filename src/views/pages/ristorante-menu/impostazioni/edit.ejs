

<% if (typeof success !== 'undefined' && success && success.length > 0) { %>
  <div class="success-message" data-success-message="<%= success[0] %>" style="display: none;">
    <%= success[0] %>
  </div>
<% } %>

<% if (typeof error !== 'undefined' && error && error.length > 0) { %>
  <div class="error-message" data-error-message="<%= error[0] %>" style="display: none;">
    <%= error[0] %>
  </div>
<% } %>

<!-- Action Navigation -->
<% if (typeof actionNavConfig !== 'undefined' && actionNavConfig) { %>
  <%- include('../../../ui/navigation/actionNav', actionNavConfig) %>
<% } %>

<div class="mt-8">
  <div class="space-y-10">
    <div class="grid grid-cols-1 gap-x-8 gap-y-8 md:grid-cols-3">
      <div class="md:col-span-2">
        <%- include('../../../ui/forms/simpleGenericForm', { ...formConfig, isBulkEdit: false }) %>
      </div>
    </div>
  </div>
</div>

<%
  // Definisci gli script per questa pagina
  pageScripts = `
    <script src="/js/subSectionForm.js"></script>
  `;
%> 