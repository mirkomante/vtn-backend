

<% if (typeof successMessage !== 'undefined' && successMessage) { %>
  <%- include('../../../ui/alerts/simple', { message: successMessage }) %>
<% } %>

<% if (typeof error !== 'undefined' && error && typeof error === 'string' && error.trim() !== '') { %>
  <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-md">
    <div class="flex items-center">
      <svg class="w-5 h-5 text-red-400 mr-2" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
      </svg>
      <span class="text-red-800"><%= error %></span>
    </div>
  </div>
<% } %>

<!-- Action Navigation -->
<% if (typeof actionNavConfig !== 'undefined' && actionNavConfig) { %>
  <%- include('../../../ui/navigation/actionNav', actionNavConfig) %>
<% } %>

<div class="mt-8">
  <div class="space-y-10">
    <div class="grid grid-cols-1 gap-x-8 gap-y-8 md:grid-cols-3">
      <div class="md:col-span-2">
        <%- include('../../../ui/forms/simpleGenericForm', { ...formConfig, isBulkEdit: false }) %>
      </div>
    </div>
  </div>
</div>

<%
  // Definisci gli script per questa pagina
  pageScripts = `
    <script src="/js/subSectionForm.js"></script>
  `;
%> 