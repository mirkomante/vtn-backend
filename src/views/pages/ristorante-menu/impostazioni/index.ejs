<div class="pt-5">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto">
      <% if (breadcrumbs) { %>
        <%- include('../../../ui/breadcrumbs/simpleWithChevrons', { breadcrumbs }) %>
      <% } else { %>
        <h1 class="text-base font-semibold text-gray-900">Impostazioni Menu</h1>
        <p class="mt-2 text-sm text-gray-700">Gestisci le configurazioni del menu ristorante.</p>
      <% } %>
    </div>
  </div>
</div>

<!-- Griglia delle sottosezioni -->
<div class="mt-8 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
  <% subSectionMenu.forEach(item => { %>
    <div class="bg-white overflow-hidden shadow rounded-lg">
      <div class="p-6">
        <div class="flex items-center">
          <% if (item.icon && sectionIcons[item.icon]) { %>
            <div class="flex-shrink-0">
              <svg class="h-8 w-8 text-gray-400" 
                   fill="none" 
                   viewBox="<%= sectionIcons[item.icon].viewBox %>" 
                   stroke-width="1.5" 
                   stroke="currentColor">
                <path stroke-linecap="round" 
                      stroke-linejoin="round" 
                      d="<%= sectionIcons[item.icon].path %>" />
              </svg>
            </div>
          <% } %>
          <div class="ml-4">
            <h3 class="text-lg font-medium text-gray-900">
              <a href="<%= item.link %>" class="hover:text-indigo-600">
                <%= item.label %>
              </a>
            </h3>
            <p class="text-sm text-gray-500">
              Gestisci <%= item.label.toLowerCase() %>
            </p>
          </div>
        </div>
      </div>
    </div>
  <% }); %>
</div> 