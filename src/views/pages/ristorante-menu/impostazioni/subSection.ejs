<% if (!hasItems || items.length === 0) { %>
  <%- include('../../../ui/emptyStates/simple', emptyState) %>
<% } else { %>
  <!-- Messaggio di successo se presente -->
  <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
    <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-md">
      <div class="flex items-center">
        <svg class="w-5 h-5 text-green-400 mr-2" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
        </svg>
        <span class="text-green-800"><%= success[0] %></span>
      </div>
    </div>
  <% } %>
  
  <!-- Messaggio di errore se presente -->
  <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-md">
      <div class="flex items-center">
        <svg class="w-5 h-5 text-red-400 mr-2" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
        </svg>
        <span class="text-red-800"><%= error[0] %></span>
      </div>
    </div>
  <% } %>
  
  <!-- Action Navigation -->
  <% if (typeof actionNavConfig !== 'undefined' && actionNavConfig) { %>
    <%- include('../../../ui/navigation/actionNav', actionNavConfig) %>
  <% } %>
  
  <%- include('../../../ui/tables/selectableTable', {
    tableId: tableConfig.tableId,
    tableData: tableData,
    items: items,
    tableConfig: {
      idField: tableConfig.idField,
      labelField: tableConfig.labelField,
      detailUrl: tableConfig.detailUrl,
      editUrl: tableConfig.editUrl,
      bulkEditUrl: tableConfig.bulkEditUrl,
      editMultipleButton: tableConfig.editMultipleButton,
      actionButton: tableConfig.deleteButton || tableConfig.actionButton,
      endpoint: tableConfig.endpoint,
      method: tableConfig.method,
      confirmMessage: tableConfig.confirmMessage,
      confirmMessageMultiple: tableConfig.confirmMessageMultiple,
      successMessage: tableConfig.successMessage,
      errorMessage: tableConfig.errorMessage,
      getDisplayValue: tableConfig.getDisplayValue,
      disableClickableNames: tableConfig.disableClickableNames
    },
    filters: typeof filters !== 'undefined' ? filters : undefined,
    hasActiveFilters: typeof hasActiveFilters !== 'undefined' ? hasActiveFilters : false,
    clearFiltersUrl: typeof clearFiltersUrl !== 'undefined' ? clearFiltersUrl : undefined,
    pagination: typeof pagination !== 'undefined' ? pagination : undefined
  }) %>
<% } %>

<!-- Configurazione JavaScript per la tabella -->
<script>
  window['<%= tableConfig.tableId %>-config'] = {
    tableId: '<%= tableConfig.tableId %>',
    idField: '<%= tableConfig.idField %>',
    labelField: '<%= tableConfig.labelField %>',
    detailUrl: '<%= tableConfig.detailUrl %>',
    editUrl: '<%= tableConfig.editUrl %>',
    bulkEditUrl: '<%= tableConfig.bulkEditUrl %>',
    editMultipleButton: <%- JSON.stringify(tableConfig.editMultipleButton || null) %>,
    actionButton: <%- JSON.stringify(tableConfig.deleteButton || tableConfig.actionButton || null) %>,
    endpoint: '<%= tableConfig.endpoint %>',
    method: '<%= tableConfig.method %>',
    confirmMessage: '<%= tableConfig.confirmMessage %>',
    confirmMessageMultiple: '<%= tableConfig.confirmMessageMultiple %>',
    successMessage: '<%= tableConfig.successMessage %>',
    errorMessage: '<%= tableConfig.errorMessage %>',
    disableClickableNames: <%= typeof tableConfig.disableClickableNames !== 'undefined' ? tableConfig.disableClickableNames : 'false' %>
  };
</script> 