<% if (!hasItems || items.length === 0) { %>
  <% if (typeof emptyState !== 'undefined' && emptyState) { %>
    <%- include('../../../ui/emptyStates/simple', emptyState) %>
  <% } else { %>
    <div class="text-center py-12">
      <div class="mx-auto h-12 w-12 text-gray-400">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
        </svg>
      </div>
      <h3 class="mt-2 text-sm font-medium text-gray-900">Nessun menu fisso disponibile</h3>
      <p class="mt-1 text-sm text-gray-500">Non ci sono menu fissi configurati nel sistema. Aggiungi il primo menu per iniziare.</p>
      <div class="mt-6">
        <a href="/ristorante-menu/menu-fissi/nuovo" class="inline-flex items-center rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
          <svg class="-ml-0.5 mr-1.5 h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path d="M10.75 4.75a.75.75 0 00-1.5 0v4.5h-4.5a.75.75 0 000 1.5h4.5v4.5a.75.75 0 001.5 0v-4.5h4.5a.75.75 0 000-1.5h-4.5v-4.5z" />
          </svg>
          Aggiungi menu
        </a>
      </div>
    </div>
  <% } %>
<% } else { %>
  <!-- Messaggio di successo se presente -->
  <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
    <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-md">
      <div class="flex items-center">
        <svg class="w-5 h-5 text-green-400 mr-2" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
        </svg>
        <span class="text-green-800"><%= success[0] %></span>
      </div>
    </div>
  <% } %>
  
  <!-- Messaggio di errore se presente -->
  <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-md">
      <div class="flex items-center">
        <svg class="w-5 h-5 text-red-400 mr-2" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
        </svg>
        <span class="text-red-800"><%= error[0] %></span>
      </div>
    </div>
  <% } %>
  
  <!-- Action Navigation -->
  <% if (typeof actionNavConfig !== 'undefined' && actionNavConfig) { %>
    <%- include('../../../ui/navigation/actionNav', actionNavConfig) %>
  <% } %>
  
  <%- include('../../../ui/tables/selectableTable', {
    tableId: 'menu-fissi-table',
    tableData: tableData,
    items: items,
    tableConfig: {
      idField: 'id',
      labelField: 'nome',
      detailUrl: '/ristorante-menu/menu-fissi/dettagli/:id',
      editUrl: '/ristorante-menu/menu-fissi/modifica/:id',
      bulkEditUrl: '/ristorante-menu/menu-fissi/modifica-massa',
      editMultipleButton: {
        text: 'Modifica'
      },
      actionButton: {
        text: 'Elimina',
        classes: 'bg-red-600 text-white ring-red-600 hover:bg-red-700 disabled:hover:bg-red-600'
      },
      endpoint: '/ristorante-menu/menu-fissi',
      method: 'DELETE',
      confirmMessage: 'Sei sicuro di voler eliminare questo menu fisso?',
      confirmMessageMultiple: 'Sei sicuro di voler eliminare {count} menu fissi?',
      successMessage: 'Eliminati {count} menu fisso/i con successo',
      errorMessage: 'Errore durante l\'eliminazione',
      getDisplayValue: (item) => item.nome
    },
    pagination: typeof pagination !== 'undefined' ? pagination : undefined
  }) %>
<% } %>

<!-- Configurazione JavaScript per la tabella -->
<script>
  window['menu-fissi-table-config'] = {
    tableId: 'menu-fissi-table',
    idField: 'id',
    labelField: 'nome',
    detailUrl: '/ristorante-menu/menu-fissi/dettagli/:id',
    editUrl: '/ristorante-menu/menu-fissi/modifica/:id',
    bulkEditUrl: '/ristorante-menu/menu-fissi/modifica-massa',
    editMultipleButton: {
      text: 'Modifica'
    },
    actionButton: {
      text: 'Elimina',
      classes: 'bg-red-600 text-white ring-red-600 hover:bg-red-700 disabled:hover:bg-red-600'
    },
    endpoint: '/ristorante-menu/menu-fissi',
    method: 'DELETE',
    confirmMessage: 'Sei sicuro di voler eliminare questo menu fisso?',
    confirmMessageMultiple: 'Sei sicuro di voler eliminare {count} menu fissi?',
    successMessage: 'Eliminati {count} menu fisso/i con successo',
    errorMessage: 'Errore durante l\'eliminazione'
  };
</script>