<% if (!hasItems) { %>
  <%- include('../../../ui/emptyStates/simple', emptyState) %>
<% } else { %>
  <!-- Messaggio di successo se presente -->
  <% if (typeof successMessage !== 'undefined' && successMessage) { %>
    <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-md">
      <div class="flex items-center">
        <svg class="w-5 h-5 text-green-400 mr-2" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
        </svg>
        <span class="text-green-800"><%= successMessage %></span>
      </div>
    </div>
  <% } %>
  
  <%- include('../../../ui/tables/selectableTable', {
    title: 'Menu Fissi',
    description: 'Lista di tutti i menu fissi del ristorante.',
    actionButton: {
      text: 'Aggiungi menu fisso',
      href: '/ristorante-menu/menu-fissi/nuovo'
    },
    tableId: 'menu-fissi-table',
    tableData: tableData,
    items: items,
    tableConfig: {
      idField: 'id',
      labelField: 'nome',
      detailUrl: '/ristorante-menu/menu-fissi/dettagli/:id',
      editUrl: '/ristorante-menu/menu-fissi/modifica/:id',
      bulkEditUrl: '/ristorante-menu/menu-fissi/modifica-massa',
      editMultipleButton: {
        text: 'Modifica'
      },
      actionButton: {
        text: 'Elimina',
        classes: 'bg-red-600 text-white ring-red-600 hover:bg-red-700 disabled:hover:bg-red-600'
      },
      endpoint: '/ristorante-menu/menu-fissi',
      method: 'DELETE',
      confirmMessage: 'Sei sicuro di voler eliminare questo menu fisso?',
      confirmMessageMultiple: 'Sei sicuro di voler eliminare {count} menu fissi?',
      successMessage: 'Eliminati {count} menu fisso/i con successo',
      errorMessage: 'Errore durante l\'eliminazione',
      getDisplayValue: (item) => item.nome
    },
    breadcrumbs: breadcrumbs
  }) %>
<% } %>

<script>
  window['menu-fissi-tableConfig'] = <%- JSON.stringify({
    idField: 'id',
    labelField: 'nome',
    detailUrl: '/ristorante-menu/menu-fissi/dettagli/:id',
    editUrl: '/ristorante-menu/menu-fissi/modifica/:id',
    bulkEditUrl: '/ristorante-menu/menu-fissi/modifica-massa',
    editMultipleButton: {
      text: 'Modifica'
    },
    actionButton: {
      text: 'Elimina',
      classes: 'bg-red-600 text-white ring-red-600 hover:bg-red-700 disabled:hover:bg-red-600'
    },
    endpoint: '/ristorante-menu/menu-fissi',
    method: 'DELETE',
    confirmMessage: 'Sei sicuro di voler eliminare questo menu fisso?',
    confirmMessageMultiple: 'Sei sicuro di voler eliminare {count} menu fissi?',
    successMessage: 'Eliminati {count} menu fisso/i con successo',
    errorMessage: 'Errore durante l\'eliminazione',
    getDisplayValue: (item) => item.nome
  }) %>
</script>
<script src="/js/selectableTable.js"></script>
<script>
  document.addEventListener('DOMContentLoaded', function() {
    initializeSelectableTable('menu-fissi-table')
  })
</script> 