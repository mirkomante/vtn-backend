<% if (!hasUsers) { %>
  <%- include('../../ui/emptyStates/simple', emptyState) %>
<% } else { %>
  <!-- Messaggio di successo se presente -->
  <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
    <div class="mb-6 p-4 bg-green-50 border border-green-200 rounded-md">
      <div class="flex items-center">
        <svg class="w-5 h-5 text-green-400 mr-2" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
        </svg>
        <span class="text-green-800"><%= success[0] %></span>
      </div>
    </div>
  <% } %>
  
  <!-- Messaggio di errore se presente -->
  <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
    <div class="mb-6 p-4 bg-red-50 border border-red-200 rounded-md">
      <div class="flex items-center">
        <svg class="w-5 h-5 text-red-400 mr-2" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
        </svg>
        <span class="text-red-800"><%= error[0] %></span>
      </div>
    </div>
  <% } %>
  
  <!-- Action Navigation -->
  <% if (typeof actionNavConfig !== 'undefined' && actionNavConfig) { %>
    <%- include('../../ui/navigation/actionNav', actionNavConfig) %>
  <% } %>

  <%- include('../../ui/tables/selectableTable', {
    tableId: 'users-table',
    tableData: tableData,
    items: users,
    showFilters: true,
    filters: [
      {
        id: 'role',
        name: 'role',
        label: 'Ruolo',
        type: 'select',
        placeholder: 'Tutti i ruoli',
        options: [
          { value: '', label: 'Tutti i ruoli', selected: !currentRoleFilter },
          { value: 'user', label: 'Utente', selected: currentRoleFilter === 'user' },
          { value: 'admin', label: 'Amministratore', selected: currentRoleFilter === 'admin' }
        ]
      }
    ],
    hasActiveFilters: !!currentRoleFilter,
    clearFiltersUrl: '/admin/utenti',
    tableConfig: {
      idField: 'id',
      labelField: 'givenName',
      detailUrl: '/admin/utenti/dettagli/:id',
      editUrl: '/admin/utenti/modifica/:id',
      bulkEditUrl: '/admin/utenti/modifica-massa',
      editMultipleButton: {
        text: 'Modifica'
      },
      actionButton: {
        text: 'Elimina',
        classes: 'bg-red-600 text-white ring-red-600 hover:bg-red-700 disabled:hover:bg-red-600'
      },
      endpoint: '/admin/utenti',
      method: 'DELETE',
      confirmMessage: 'Sei sicuro di voler eliminare questo utente?',
      confirmMessageMultiple: 'Sei sicuro di voler eliminare {count} utenti?',
      successMessage: 'Eliminati {count} utente/i con successo',
      errorMessage: 'Errore durante l\'eliminazione',
      disableClickableNames: false
    }
  }) %>
<% } %> 