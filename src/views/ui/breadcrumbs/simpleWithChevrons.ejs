<nav aria-label="Breadcrumb" class="flex">
  <div class="overflow-x-auto scrollbar-hide" style="scroll-behavior: smooth;">
    <ol role="list" class="flex items-center space-x-4 min-w-max">
      <!-- Home sempre presente -->
      <li class="flex-shrink-0">
        <div>
          <a href="/" class="text-gray-400 hover:text-gray-500">
            <svg viewBox="0 0 20 20" fill="currentColor" data-slot="icon" aria-hidden="true" class="size-6 sm:size-5 shrink-0">
              <path d="M9.293 2.293a1 1 0 0 1 1.414 0l7 7A1 1 0 0 1 17 11h-1v6a1 1 0 0 1-1 1h-2a1 1 0 0 1-1-1v-3a1 1 0 0 0-1-1H9a1 1 0 0 0-1 1v3a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1v-6H3a1 1 0 0 1-.707-1.707l7-7Z" clip-rule="evenodd" fill-rule="evenodd" />
            </svg>
            <span class="sr-only">Dashboard</span>
          </a>
        </div>
      </li>
      
      <% if (breadcrumbs && breadcrumbs.length > 0) { %>
        <% breadcrumbs.forEach((item, index) => { %>
          <li class="flex-shrink-0">
            <div class="flex items-center">
              <svg viewBox="0 0 20 20" fill="currentColor" data-slot="icon" aria-hidden="true" class="size-6 sm:size-5 shrink-0 text-gray-400">
                <path d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" fill-rule="evenodd" />
              </svg>
              <% if (index === breadcrumbs.length - 1) { %>
                <!-- Ultimo elemento (pagina corrente) -->
                <span class="ml-4 px-2 py-2 sm:px-1 sm:py-1 text-base sm:text-sm font-medium text-gray-900 whitespace-nowrap"><%= item.label %></span>
              <% } else { %>
                <!-- Elementi intermedi -->
                <a href="<%= item.href %>" class="ml-4 px-2 py-2 sm:px-1 sm:py-1 text-base sm:text-sm font-medium text-gray-500 hover:text-gray-700 whitespace-nowrap"><%= item.label %></a>
              <% } %>
            </div>
          </li>
        <% }); %>
      <% } %>
    </ol>
  </div>
</nav>  