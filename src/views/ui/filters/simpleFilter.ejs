<% if (filters && filters.length > 0) { %>
  <form id="filter-form" method="GET" class="flex flex-wrap items-end gap-4">
    <% filters.forEach(filter => { %>
      <div class="flex flex-col min-w-[200px]">
        <% if (filter.label) { %>
          <label for="<%= filter.id %>" class="block text-sm font-medium text-gray-700 mb-1">
            <%= filter.label %>
          </label>
        <% } %>
        
        <% if (filter.type === 'select') { %>
          <div class="relative w-full">
            <button 
              type="button"
              id="<%= filter.id %>-button"
              class="relative w-full cursor-default rounded-md bg-white py-1.5 pl-3 pr-10 text-left text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:outline-none focus:ring-2 focus:ring-indigo-600 sm:text-sm sm:leading-6 min-h-[38px]"
              aria-haspopup="listbox"
              aria-expanded="false"
              aria-labelledby="<%= filter.id %>-label"
            >
              <span class="block truncate" id="<%= filter.id %>-selected">
                <% 
                  const selectedOption = filter.options.find(opt => opt.selected);
                  const displayText = selectedOption ? selectedOption.label : (filter.placeholder || 'Seleziona...');
                %>
                <%= displayText %>
              </span>
              <span class="pointer-events-none absolute inset-y-0 right-0 flex items-center pr-2">
                <svg class="h-5 w-5 text-gray-400" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                  <path fill-rule="evenodd" d="M10 3a.75.75 0 01.55.24l3.25 3.5a.75.75 0 11-1.1 1.02L10 4.852 7.3 7.76a.75.75 0 01-1.1-1.02l3.25-3.5A.75.75 0 0110 3zm-3.76 9.2a.75.75 0 011.06.04l2.7 2.908 2.7-2.908a.75.75 0 111.1 1.04l-3.25 3.5a.75.75 0 01-1.1 0l-3.25-3.5a.75.75 0 01.04-1.06z" clip-rule="evenodd" />
                </svg>
              </span>
            </button>
            
            <select 
              id="<%= filter.id %>" 
              name="<%= filter.name %>"
              class="sr-only"
              <%= filter.multiple ? 'multiple' : '' %>
            >
              <% filter.options.forEach(option => { %>
                <option value="<%= option.value %>" <%= option.selected ? 'selected' : '' %>>
                  <%= option.label %>
                </option>
              <% }); %>
            </select>

            <ul 
              id="<%= filter.id %>-options"
              class="absolute z-10 mt-1 max-h-60 w-full overflow-auto rounded-md bg-white py-1 text-base shadow-lg ring-1 ring-inset ring-gray-300 focus:outline-none sm:text-sm hidden"
              tabindex="-1"
              role="listbox"
              aria-labelledby="<%= filter.id %>-label"
            >
              <% filter.options.forEach(option => { %>
                <li 
                  class="relative cursor-default select-none py-2 pl-3 pr-9 hover:bg-indigo-600 hover:text-white <%= option.selected ? 'bg-indigo-600 text-white' : 'text-gray-900' %>"
                  role="option"
                  data-value="<%= option.value %>"
                  aria-selected="<%= option.selected ? 'true' : 'false' %>"
                >
                  <span class="block truncate <%= option.selected ? 'font-semibold' : 'font-normal' %>">
                    <%= option.label %>
                  </span>
                  <% if (option.selected) { %>
                    <span class="absolute inset-y-0 right-0 flex items-center pr-4 text-white">
                      <svg class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                      </svg>
                    </span>
                  <% } %>
                </li>
              <% }); %>
            </ul>
          </div>
        <% } else if (filter.type === 'input') { %>
          <input 
            type="<%= filter.inputType || 'text' %>"
            id="<%= filter.id %>"
            name="<%= filter.name %>"
            placeholder="<%= filter.placeholder || '' %>"
            value="<%= filter.value || '' %>"
            class="block w-full rounded-md bg-white py-1.5 pl-3 pr-3 text-left text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-indigo-600 sm:text-sm min-h-[38px]"
          />
        <% } else if (filter.type === 'date') { %>
          <input 
            type="date"
            id="<%= filter.id %>"
            name="<%= filter.name %>"
            value="<%= filter.value || '' %>"
            class="block w-full rounded-md bg-white py-1.5 pl-3 pr-3 text-left text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus-visible:outline-2 focus-visible:-outline-offset-2 focus-visible:outline-indigo-600 sm:text-sm min-h-[38px]"
          />
        <% } %>
      </div>
    <% }); %>
    
    <% if (hasActiveFilters) { %>
      <div class="flex items-center">
        <a 
          href="<%= clearFiltersUrl || window.location.pathname %>"
          class="block rounded-md bg-gray-600 px-3 py-2 text-center text-sm font-semibold text-white shadow-xs hover:bg-gray-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-600 min-h-[38px]"
        >
          Azzera
        </a>
      </div>
    <% } %>
  </form>
<% } %>