<form class="max-w-md mx-auto" 
      method="<%= formConfig.method %>" 
      action="<%= formConfig.action %>" 
      id="<%= formConfig.id %>" 
      <%= formConfig.novalidate ? 'novalidate' : '' %>
      <%= formConfig.enctype ? `enctype="${formConfig.enctype}"` : '' %>>
  
  <!-- Campi nascosti per la modifica massiva -->
  <% if (formConfig.hiddenFields) { %>
    <% formConfig.hiddenFields.forEach(function(field) { %>
      <input type="hidden" name="<%= field.name %>" value="<%= field.value %>">
    <% }); %>
  <% } %>
  
  <div class="space-y-6">
    <% fields.forEach(function(field) { %>
      <div>
        <% if (field.type !== 'toggle') { %>
          <label for="<%= field.id %>" class="block text-sm/6 font-medium text-gray-900"><%= field.label %></label>
        <% } %>
        <div class="mt-2 grid grid-cols-1">
          
          <% if (field.type === 'select') { %>
            <!-- Select field -->
            <select name="<%= field.name %>" 
                    id="<%= field.id %>" 
                    <%= field.required ? 'required' : '' %>
                    class="col-start-1 row-start-1 w-full appearance-none rounded-md bg-white py-1.5 pr-8 pl-3 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6">
              <% if (field.placeholder) { %>
                <option value=""><%= field.placeholder %></option>
              <% } %>
              <% field.options.forEach(function(option) { %>
                <option value="<%= option.value %>" 
                        <%= (field.value && field.value === option.value) ? 'selected' : '' %>>
                  <%= option.label %>
                </option>
              <% }); %>
            </select>
            <svg class="pointer-events-none col-start-1 row-start-1 mr-2 size-5 self-center justify-self-end text-red-500 sm:size-4 hidden" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" data-slot="icon" role="img" aria-label="Error icon">
              <path fill-rule="evenodd" d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
            </svg>
            
          <% } else if (field.type === 'textarea') { %>
            <!-- Textarea field -->
            <textarea name="<%= field.name %>" 
                      id="<%= field.id %>" 
                      <%= field.required ? 'required' : '' %>
                      placeholder="<%= field.placeholder || '' %>"
                      rows="4"
                      class="col-start-1 row-start-1 block w-full rounded-md bg-white py-1.5 pr-10 pl-3 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:pr-9 sm:text-sm/6"><%= field.value || '' %></textarea>
            <svg class="pointer-events-none col-start-1 row-start-1 mr-3 size-5 self-center justify-self-end text-red-500 sm:size-4 hidden" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" data-slot="icon" role="img" aria-label="Error icon">
              <path fill-rule="evenodd" d="M8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14ZM8 4a.75.75 0 0 1 .75.75v3a.75.75 0 0 1-1.5 0v-3A.75.75 0 0 1 8 4Zm0 8a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" />
            </svg>
            
          <% } else if (field.type === 'toggle') { %>
            <!-- Toggle field -->
            <div class="toggle-container">
              <div class="flex items-center gap-2">
                <div class="group relative inline-flex w-11 shrink-0 rounded-full bg-gray-200 p-0.5 inset-ring inset-ring-gray-900/5 outline-offset-2 outline-indigo-600 transition-colors duration-200 ease-in-out <%= (field.value === true || field.value === 'true' || field.value === 'on') ? 'has-checked bg-indigo-600' : '' %> focus-within:outline-2">
                  <span class="size-5 rounded-full bg-white shadow-xs ring-1 ring-gray-900/5 transition-transform duration-200 ease-in-out <%= (field.value === true || field.value === 'true' || field.value === 'on') ? 'translate-x-5' : '' %>"></span>
                  <input 
                    id="<%= field.id %>" 
                    type="checkbox" 
                    name="<%= field.name %>" 
                    aria-labelledby="<%= field.id %>-label" 
                    class="absolute inset-0 appearance-none focus:outline-hidden"
                    <%= (field.value === true || field.value === 'true' || field.value === 'on') ? 'checked' : '' %>
                  />
                </div>

                <label id="<%= field.id %>-label" class="text-sm font-medium text-gray-900"><%= field.label %></label>
              </div>
            </div>
            
          <% } else { %>
            <!-- Input field -->
            <input type="<%= field.type %>" 
                   name="<%= field.name %>" 
                   id="<%= field.id %>" 
                   <%= field.required ? 'required' : '' %>
                   value="<%= field.value || '' %>"
                   placeholder="<%= field.placeholder || '' %>"
                   <%= field.min ? `min="${field.min}"` : '' %>
                   <%= field.max ? `max="${field.max}"` : '' %>
                   <%= field.step ? `step="${field.step}"` : '' %>
                   <%= field.pattern ? `pattern="${field.pattern}"` : '' %>
                   class="col-start-1 row-start-1 block w-full rounded-md bg-white py-1.5 pr-10 pl-3 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:pr-9 sm:text-sm/6">
            <svg class="pointer-events-none col-start-1 row-start-1 mr-3 size-5 self-center justify-self-end text-red-500 sm:size-4 hidden" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" data-slot="icon" role="img" aria-label="Error icon">
              <path fill-rule="evenodd" d="M8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14ZM8 4a.75.75 0 0 1 .75.75v3a.75.75 0 0 1-1.5 0v-3A.75.75 0 0 1 8 4Zm0 8a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" />
            </svg>
          <% } %>
          
        </div>
        <% if (field.errorMessage) { %>
          <p class="mt-2 text-sm text-red-600 hidden" id="<%= field.id %>-error"><%= field.errorMessage %></p>
        <% } %>
        <% if (field.bulkHelpText && typeof isBulkEdit !== 'undefined' && isBulkEdit) { %>
          <p class="mt-2 text-sm text-gray-500"><%= field.bulkHelpText %></p>
        <% } %>
      </div>
    <% }); %>
  </div>

  <div class="mt-6 flex items-center justify-center gap-x-6">
    <% if (buttons.cancel) { %>
      <a href="<%= buttons.cancel.href %>" 
         class="<%= buttons.cancel.classes || 'text-sm font-semibold leading-6 text-gray-900' %>">
        <%= buttons.cancel.text %>
      </a>
    <% } %>
    
    <button type="submit" 
            class="<%= buttons.submit.classes || 'rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 disabled:opacity-50 disabled:cursor-not-allowed' %>">
      <%= buttons.submit.text %>
    </button>
  </div>
</form>