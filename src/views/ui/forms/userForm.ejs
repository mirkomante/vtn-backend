<form class="max-w-md mx-auto" method="POST" action="<%= isEdit ? `/admin/utenti/modifica/${user.id}` : '/admin/utenti/nuovo' %>" id="userForm" novalidate>
  <div class="space-y-6">
    <div>
      <label for="nome" class="block text-sm/6 font-medium text-gray-900">Nome</label>
      <div class="mt-2 grid grid-cols-1">
        <input type="text" name="nome" id="nome" required
          value="<%= (typeof formData !== 'undefined' && formData && formData.nome) || (isEdit && user && user.givenName) || '' %>"
          placeholder="Mario"
          class="col-start-1 row-start-1 block w-full rounded-md bg-white py-1.5 pr-10 pl-3 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:pr-9 sm:text-sm/6">
        <svg class="pointer-events-none col-start-1 row-start-1 mr-3 size-5 self-center justify-self-end text-red-500 sm:size-4 hidden" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" data-slot="icon">
          <path fill-rule="evenodd" d="M8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14ZM8 4a.75.75 0 0 1 .75.75v3a.75.75 0 0 1-1.5 0v-3A.75.75 0 0 1 8 4Zm0 8a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" />
        </svg>
      </div>
      <p class="mt-2 text-sm text-red-600 hidden" id="nome-error">Il nome è obbligatorio</p>
    </div>

    <div>
      <label for="cognome" class="block text-sm/6 font-medium text-gray-900">Cognome</label>
      <div class="mt-2 grid grid-cols-1">
        <input type="text" name="cognome" id="cognome" required
          value="<%= (typeof formData !== 'undefined' && formData && formData.cognome) || (isEdit && user && user.familyName) || '' %>"
          placeholder="Rossi"
          class="col-start-1 row-start-1 block w-full rounded-md bg-white py-1.5 pr-10 pl-3 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:pr-9 sm:text-sm/6">
        <svg class="pointer-events-none col-start-1 row-start-1 mr-3 size-5 self-center justify-self-end text-red-500 sm:size-4 hidden" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" data-slot="icon">
          <path fill-rule="evenodd" d="M8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14ZM8 4a.75.75 0 0 1 .75.75v3a.75.75 0 0 1-1.5 0v-3A.75.75 0 0 1 8 4Zm0 8a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" />
        </svg>
      </div>
      <p class="mt-2 text-sm text-red-600 hidden" id="cognome-error">Il cognome è obbligatorio</p>
    </div>

    <div>
      <label for="email" class="block text-sm/6 font-medium text-gray-900">Email</label>
      <div class="mt-2 grid grid-cols-1">
        <input type="email" name="email" id="email" required
          value="<%= (isEdit && user && user.email) || (typeof formData !== 'undefined' && formData && formData.email) || '' %>"
          class="col-start-1 row-start-1 block w-full rounded-md bg-white py-1.5 pr-10 pl-3 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:pr-9 sm:text-sm/6"
          placeholder="you@example.com">
        <svg class="pointer-events-none col-start-1 row-start-1 mr-3 size-5 self-center justify-self-end text-red-500 sm:size-4 hidden" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" data-slot="icon">
          <path fill-rule="evenodd" d="M8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14ZM8 4a.75.75 0 0 1 .75.75v3a.75.75 0 0 1-1.5 0v-3A.75.75 0 0 1 8 4Zm0 8a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" />
        </svg>
      </div>
      <p class="mt-2 text-sm text-red-600 hidden" id="email-error">Inserisci un indirizzo email valido</p>
    </div>

    <div>
      <label for="password" class="block text-sm/6 font-medium text-gray-900">Password</label>
      <div class="mt-2 grid grid-cols-1">
        <input type="password" name="password" id="password" <%= !isEdit ? 'required' : '' %>
          class="col-start-1 row-start-1 block w-full rounded-md bg-white py-1.5 pr-10 pl-3 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:pr-9 sm:text-sm/6"
          placeholder="<%= isEdit ? 'Lascia vuoto per non modificare' : '' %>">
        <svg class="pointer-events-none col-start-1 row-start-1 mr-3 size-5 self-center justify-self-end text-red-500 sm:size-4 hidden" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" data-slot="icon">
          <path fill-rule="evenodd" d="M8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14ZM8 4a.75.75 0 0 1 .75.75v3a.75.75 0 0 1-1.5 0v-3A.75.75 0 0 1 8 4Zm0 8a1 1 0 1 0 0-2 1 1 0 0 0 0 2Z" clip-rule="evenodd" />
        </svg>
      </div>
      <p class="mt-2 text-sm text-red-600 hidden" id="password-error">La password deve contenere almeno 8 caratteri, una lettera maiuscola, una minuscola e un numero</p>
      
    </div>

    <div>
      <label for="ruolo" class="block text-sm/6 font-medium text-gray-900">Ruolo</label>
      <div class="mt-2 grid grid-cols-1">
        <select name="ruolo" id="ruolo" required
          class="col-start-1 row-start-1 w-full appearance-none rounded-md bg-white py-1.5 pr-8 pl-3 text-base text-gray-900 outline-1 -outline-offset-1 outline-gray-300 focus:outline-2 focus:-outline-offset-2 focus:outline-indigo-600 sm:text-sm/6">
          <option value="">Seleziona un ruolo</option>
          <option value="user" <%= ((isEdit && user && user.role === 'user') || (typeof formData !== 'undefined' && formData && formData.ruolo === 'user')) ? 'selected' : '' %>>Utente</option>
          <option value="admin" <%= ((isEdit && user && user.role === 'admin') || (typeof formData !== 'undefined' && formData && formData.ruolo === 'admin')) ? 'selected' : '' %>>Amministratore</option>
        </select>
        <svg class="pointer-events-none col-start-1 row-start-1 mr-2 size-5 self-center justify-self-end text-red-500 sm:size-4 hidden" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true" data-slot="icon">
          <path fill-rule="evenodd" d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
        </svg>
      </div>
      <p class="mt-2 text-sm text-red-600 hidden" id="ruolo-error">Seleziona un ruolo</p>
    </div>
  </div>

  <div class="mt-6 flex items-center justify-center gap-x-6">
    <a href="<%= isEdit ? `/admin/utenti/dettagli/${user.id}` : '/admin/utenti' %>" class="text-sm font-semibold leading-6 text-gray-900">Annulla</a>
    <button type="submit" disabled
      class="rounded-md bg-indigo-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600 disabled:opacity-50 disabled:cursor-not-allowed">
      <%= isEdit ? 'Aggiorna' : 'Salva' %>
    </button>
  </div>
</form>
