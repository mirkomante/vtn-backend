<% actions.forEach(action => { %>
  <% if (action.type === 'link') { %>
    <a href="<%= action.href %>" 
       class="<%= action.classes || 'block rounded-md bg-gray-600 px-3 py-2 text-center text-sm font-semibold text-white shadow-xs hover:bg-gray-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-gray-600' %>">
      <%= action.text %>
    </a>
  <% } else if (action.type === 'button') { %>
    <button type="button" 
            id="<%= action.id %>"
            class="<%= action.classes || 'block rounded-md bg-indigo-600 px-3 py-2 text-center text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600' %>">
      <%= action.text %>
    </button>
  <% } %>
<% }); %> 