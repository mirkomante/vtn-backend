<!-- 
  Componente Tabs con Underline
  Parametri dal layout:
  - sectionTabs: array di oggetti con { label, link, icon? }
  - currentPath: path corrente per determinare la tab attiva
-->
<div>
  <div class="grid grid-cols-1 sm:hidden">
    <!-- Select per mobile -->
    <select aria-label="Seleziona una sezione" class="col-start-1 row-start-1 w-full appearance-none rounded-md bg-white py-1.5 pl-3 pr-12 text-left text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-indigo-600 sm:text-sm sm:leading-6">
      <% sectionTabs.forEach(tab => { %>
        <option value="<%= tab.link %>" <%= currentPath === tab.link ? 'selected' : '' %>>
          <%= tab.label %>
        </option>
      <% }); %>
    </select>
    <svg viewBox="0 0 16 16" fill="currentColor" data-slot="icon" aria-hidden="true" class="pointer-events-none col-start-1 row-start-1 mr-2 size-5 self-center justify-self-end fill-gray-500">
      <path d="M4.22 6.22a.75.75 0 0 1 1.06 0L8 8.94l2.72-2.72a.75.75 0 1 1 1.06 1.06l-3.25 3.25a.75.75 0 0 1-1.06 0L4.22 7.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" fill-rule="evenodd" />
    </svg>
  </div>

  <div class="hidden sm:block">
    <div class="border-b border-gray-200 relative">
      <!-- Indicatori di scroll -->
      <div class="absolute left-0 top-0 bottom-0 w-8 bg-gradient-to-r from-white to-transparent z-10 pointer-events-none" id="scroll-indicator-left"></div>
      <div class="absolute right-0 top-0 bottom-0 w-8 bg-gradient-to-l from-white to-transparent z-10 pointer-events-none" id="scroll-indicator-right"></div>
      
      <nav aria-label="Tabs" class="-mb-px overflow-x-auto scrollbar-hide relative" style="scroll-behavior: smooth;" id="tabs-container">
        <div class="flex space-x-8 min-w-max" id="tabs-content">
          <% sectionTabs.forEach(tab => { %>
            <% const isActive = currentPath === tab.link; %>
            <a href="<%= tab.link %>" 
               class="border-b-2 px-1 py-4 text-sm font-medium whitespace-nowrap flex-shrink-0 <%= isActive ? 'border-indigo-500 text-indigo-600' : 'border-transparent text-gray-500 hover:border-gray-300 hover:text-gray-700' %>"
               <%= isActive ? 'aria-current="page"' : '' %>>
              <%= tab.label %>
            </a>
          <% }); %>
        </div>
      </nav>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  const tabsContainer = document.getElementById('tabs-container');
  const leftIndicator = document.getElementById('scroll-indicator-left');
  const rightIndicator = document.getElementById('scroll-indicator-right');
  
  if (!tabsContainer || !leftIndicator || !rightIndicator) return;
  
  function updateScrollIndicators() {
    const { scrollLeft, scrollWidth, clientWidth } = tabsContainer;
    
    // Mostra/nascondi indicatore sinistro
    if (scrollLeft > 0) {
      leftIndicator.style.opacity = '1';
    } else {
      leftIndicator.style.opacity = '0';
    }
    
    // Mostra/nascondi indicatore destro
    if (scrollLeft < scrollWidth - clientWidth - 1) {
      rightIndicator.style.opacity = '1';
    } else {
      rightIndicator.style.opacity = '0';
    }
  }
  
  // Aggiorna indicatori al caricamento
  updateScrollIndicators();
  
  // Aggiorna indicatori durante lo scroll
  tabsContainer.addEventListener('scroll', updateScrollIndicators);
  
  // Aggiorna indicatori al resize della finestra
  window.addEventListener('resize', updateScrollIndicators);
  
  // Scroll fluido verso la tab attiva se è fuori dalla vista
  const activeTab = tabsContainer.querySelector('[aria-current="page"]');
  if (activeTab) {
    const containerRect = tabsContainer.getBoundingClientRect();
    const tabRect = activeTab.getBoundingClientRect();
    
    // Se la tab attiva è fuori dalla vista, scrolla verso di essa
    if (tabRect.left < containerRect.left || tabRect.right > containerRect.right) {
      activeTab.scrollIntoView({
        behavior: 'smooth',
        block: 'nearest',
        inline: 'center'
      });
    }
  }
});
</script>
  