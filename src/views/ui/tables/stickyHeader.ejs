<div class="px-4 sm:px-6 lg:px-8">
  <div class="sm:flex sm:items-center">
    <div class="sm:flex-auto">
      <h1 class="text-base font-semibold text-gray-900"><%= title || 'Utenti' %></h1>
      <p class="mt-2 text-sm text-gray-700"><%= description || 'Lista di tutti gli utenti registrati nel sistema.' %></p>
    </div>
    <div class="mt-4 sm:mt-0 sm:ml-16 sm:flex-none">
      <% if (actionButton) { %>
        <a href="<%= actionButton.href %>" 
           class="block rounded-md bg-indigo-600 px-3 py-2 text-center text-sm font-semibold text-white shadow-xs hover:bg-indigo-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
          <%= actionButton.text %>
        </a>
      <% } %>
    </div>
  </div>
  <div class="mt-8 flow-root">
    <div class="-mx-4 -my-2 sm:-mx-6 lg:-mx-8">
      <div class="inline-block min-w-full py-2 align-middle">
        <table class="min-w-full border-separate border-spacing-0">
          <thead>
            <tr>
              <% tableData.tableHeads.forEach(head => { %>
                <th scope="col" class="sticky top-0 z-10 border-b border-gray-300 bg-white/75 px-3 py-3.5 text-left text-sm font-semibold text-gray-900 backdrop-blur-sm backdrop-filter <%= !head.mobile ? 'hidden sm:table-cell' : '' %>">
                  <%= head.label %>
                </th>
              <% }); %>
            </tr>
          </thead>
          <tbody>
            <% users.forEach(user => { %>
              <tr>
                <% tableData.fields.forEach((field, index) => { %>
                  <td class="border-b border-gray-200 px-3 py-4 text-sm whitespace-nowrap text-gray-500 <%= !tableData.tableHeads[index].mobile ? 'hidden sm:table-cell' : '' %>">
                    <% if (field.type === 'button') { %>
                      <a href="#" class="text-indigo-600 hover:text-indigo-900">Modifica<span class="sr-only">, <%= user.displayName %></span></a>
                    <% } else if (field.name === 'name') { %>
                      <a href="/admin/utenti/dettagli/<%= user.id %>" class="text-indigo-600 hover:text-indigo-900"><%= user[field.name] %></a>
                    <% } else { %>
                      <%= user[field.name] %>
                    <% } %>
                  </td>
                <% }); %>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</div>
